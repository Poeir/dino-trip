# Local backend API (Express), run separately: cd backend && npm run dev
VITE_API_URL=http://localhost:4000
# Tourist auth (login/signup/session) also goes through this backend --
# see backend/src/routes/auth.routes.js -- so no Supabase credential is
# ever needed here in the frontend.

# Local chatbot-service (FastAPI), run separately: cd chatbot-service && uvicorn src.main:app --reload
VITE_CHATBOT_SERVICE_URL=http://localhost:8000
