# Local backend API (Express), run separately: cd backend && npm run dev
VITE_API_URL=http://localhost:4000
# Tourist auth (login/signup/session) also goes through this backend --
# see backend/src/routes/auth.routes.js -- so no Supabase credential is
# ever needed here in the frontend.

# Local chatbot-service (FastAPI), run separately: cd chatbot-service && uvicorn src.main:app --reload
VITE_CHATBOT_SERVICE_URL=http://localhost:8000

# Public URL of the deployed site, baked into index.html's canonical / Open Graph
# tags at build time (link-preview crawlers need absolute URLs). Leave unset for
# local dev; deploy/docker-compose.yml sets it from CHAT_DOMAIN.
# VITE_SITE_URL=https://example.com

# Google Maps JavaScript API key for the trip-plan route map (DayRouteMap.jsx)
# and the admin location picker (LocationPicker.jsx, used by PlacesTab and
# EventsTab's "search Google Maps" venue picker).
# Create a SEPARATE key from backend's GOOGLE_PLACES_API_KEY, restricted by
# HTTP referrer (your domain + localhost) in Google Cloud Console -- this key
# ships in the client bundle, so the referrer restriction is what protects it,
# not secrecy. Enable "Maps JavaScript API" AND "Places API" on the same GCP
# project.
VITE_GOOGLE_MAPS_API_KEY=
