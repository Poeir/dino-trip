KKU_API_KEY=your_kku_gateway_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional -- all fall back to the defaults this app has always used if unset.
# LLM_BASE_URL / MODEL_NAME: the gateway URL and model used for chat + events
# extraction. TRIP_PLANNER_MODEL_NAME: model used for trip generation + the
# LLM-as-a-judge quality check. DESCRIPTION_MODEL_NAME: model used by
# scripts/generate_descriptions.py. All three model vars are kept separate so
# trying a different model for one doesn't affect the others -- useful for
# generate_descriptions.py especially, since it can burn a model's whole daily
# quota on the KKU gateway in one run. See core/config.py for full notes
# (including why EMBEDDING_MODEL_NAME needs a re-embed, not just a restart,
# if you change it). Run gateway's /models endpoint to see what's available.
# LLM_BASE_URL=https://gen.ai.kku.ac.th/api/v1
# MODEL_NAME=gemini-2.5-flash
# TRIP_PLANNER_MODEL_NAME=gemini-2.5-pro
# DESCRIPTION_MODEL_NAME=gemini-2.5-flash
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# intfloat/multilingual-e5-small is also 384-d (no migration) and scored better
# offline (see core/config.py). The e5 "passage: "/"query: " prefixes are added
# automatically. Switch ONLY together with a full re-embed
# (python scripts/embed_content.py): until then stored vectors and queries come
# from different models and search silently returns the wrong places.

# Used only by scripts/generate_descriptions.py -- Google Search results via
# serper.dev (Google's own Custom Search JSON API is closed to new customers).
# Sign up at serper.dev for a key.
SERPER_API_KEY=your-serper-dev-api-key

# --- Vertex AI instead of the KKU gateway (optional) ---
# Dev: run `gcloud auth application-default login` once; no key needed.
# VM:  set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Models get a "google/" prefix; LLM_BASE_URL/MODEL_NAME defaults switch automatically.
# LLM_PROVIDER=vertex
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=global

# --- Claude for the chatbot only (experimental, optional) ---
# Chat (query rewrite + answer) runs on Claude via Anthropic's OpenAI-compatible
# endpoint; trip planner / events extraction stay on LLM_PROVIDER (that endpoint
# rejects response_format json_object). Leave CHAT_LLM_PROVIDER unset to turn off.
# Put the real key only in .env (gitignored), never in this file.
# CHAT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # needed when the key is not scoped to a workspace
# CHAT_MODEL_NAME=claude-haiku-5-5
# Cost tracking uses these for the chat model (haiku-5-5 rates):
# LLM_PRICE_INPUT_PER_M=0.1
# LLM_PRICE_OUTPUT_PER_M=0.5
