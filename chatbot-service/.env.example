SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- The LLM (one for everything) ---
# Chat, trip planner (generator + judge), event extraction, place descriptions
# and the data scripts all use LLM_PROVIDER + MODEL_NAME (see core/config.py).
# Switching is these two lines plus that provider's key.
#
# A) KKU gateway (default when LLM_PROVIDER is unset). Its /models endpoint
#    lists what's available.
KKU_API_KEY=your_kku_gateway_api_key
# LLM_PROVIDER=kku
# MODEL_NAME=gemini-2.5-flash
# LLM_BASE_URL=https://gen.ai.kku.ac.th/api/v1
#
# B) Claude. JSON calls (trip planner, judge, events, descriptions) use the
#    native Anthropic API with schema-enforced output; chat uses Anthropic's
#    OpenAI-compatible endpoint. Put the real key only in .env (gitignored).
# LLM_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # needed when the key is not scoped to a workspace
#
# C) Vertex AI. Dev: run `gcloud auth application-default login` once; no key
#    needed. VM: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json.
#    Models get a "google/" prefix; LLM_BASE_URL/MODEL_NAME defaults switch automatically.
# LLM_PROVIDER=vertex
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_LOCATION=global
#
# Cost tracking (src/core/usage.py) prices tokens with these -- set them to the
# active model's rates (USD per 1M tokens). Defaults are gemini-3.8-flash;
# claude-haiku-5-5 is 0.1 / 0.5.
# LLM_PRICE_INPUT_PER_M=0.75
# LLM_PRICE_OUTPUT_PER_M=3.75

# --- Embeddings ---
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# intfloat/multilingual-e5-small is also 384-d (no migration) and scored better
# offline (see core/config.py). The e5 "passage: "/"query: " prefixes are added
# automatically. Switch ONLY together with a full re-embed
# (python scripts/embed_content.py): until then stored vectors and queries come
# from different models and search silently returns the wrong places.

# Used only by scripts/generate_descriptions.py -- Google Search results via
# serper.dev (Google's own Custom Search JSON API is closed to new customers).
# Sign up at serper.dev for a key.
SERPER_API_KEY=your-serper-dev-api-key
