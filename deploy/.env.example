# Copy to deploy/.env on the VPS. Read by docker compose for ${...} values.

# The site's hostname -- the one DNS name that serves the frontend, /api and
# the chatbot (Caddy gets its HTTPS cert for it). Doesn't need to be a name
# you bought: the VPS's own hostname from the provider works.
CHAT_DOMAIN=vps-xxxxxxxx.vps.ovh.ca

# Google Maps JavaScript API key, baked into the frontend bundle at build time
# (a browser key: protect it with an HTTP referrer restriction for the site
# above, not by secrecy). Same value as VITE_GOOGLE_MAPS_API_KEY in frontend/.env.
VITE_GOOGLE_MAPS_API_KEY=
