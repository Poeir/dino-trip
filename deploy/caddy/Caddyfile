{$CHAT_DOMAIN} {
	# Baseline hardening for every response. Deliberately no full CSP: the app
	# pulls scripts/tiles/images from Google Maps and Cloudinary, and a strict
	# policy written blind would break it. frame-ancestors alone only stops the
	# site being embedded in someone else's page (clickjacking).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
		-Server
	}

	# SEO. robots.txt and sitemap.xml are generated by the backend (they need
	# the site URL and the list of places/events).
	@seo_files path /robots.txt /sitemap.xml
	handle @seo_files {
		reverse_proxy backend:4000
	}

	# The site is a client-rendered SPA, so crawlers that don't run JavaScript
	# (search bots, LINE/Facebook link previews) get a server-rendered page for
	# the same URL from the backend instead. People never match this.
	@crawler {
		header_regexp ua User-Agent (?i)(googlebot|google-inspectiontool|bingbot|bingpreview|duckduckbot|applebot|yandexbot|baiduspider|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|whatsapp|line-poker|linebot|pinterestbot|redditbot|embedly|skypeuripreview)
		path / /places /places/* /events /events/* /trip
	}
	handle @crawler {
		rewrite * /api/seo/page{path}
		reverse_proxy backend:4000
	}

	# Only what the browser itself calls is exposed. The chatbot's /admin/* and
	# /events/* have no auth of their own, so they stay reachable only from the
	# backend over the internal Docker network.
	handle /api/* {
		# The API's JSON (e.g. the places list, ~100KB) is sent uncompressed by
		# Express; compress it here. Not applied to /chat/ below (SSE).
		encode zstd gzip
		reverse_proxy backend:4000
	}

	# No `encode` on these: /chat/ streams its answer over SSE and must not be
	# buffered or re-compressed.
	handle /chat/* {
		reverse_proxy chatbot:8000 {
			flush_interval -1
		}
	}
	# Only the planner endpoint itself: /trip/result and /trip/<id> are pages of
	# the React app (a saved trip, a refresh of the result page) and must reach
	# the SPA fallback below, not the chatbot.
	handle /trip/llm {
		reverse_proxy chatbot:8000 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy chatbot:8000
	}

	# Everything else is the React app (SPA fallback so deep links/refresh work).
	handle {
		root * /srv
		encode zstd gzip

		# Caching. Vite names its JS/CSS bundles after a content hash, so a given
		# file name never changes: cache it for a year. Other static files keep
		# their names when edited (e.g. the mascot images), so only a week, with
		# a day of serve-stale while revalidating. Everything else -- index.html
		# and the SPA fallback for deep links -- must always be revalidated or
		# visitors would keep an old shell pointing at deleted bundles.
		@hashed path_regexp ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@static {
			path /assets/* /font/*
			not path_regexp ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css)$
		}
		header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		@shell not path /assets/* /font/*
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

# The previous hostname (e.g. the provider's own vps-xxxx name) keeps working
# by redirecting to the real one, so links in emails already sent don't break.
# When OLD_DOMAIN isn't set this falls back to `localhost`, which Caddy serves
# with its internal CA (no public certificate attempt) and nobody reaches.
{$OLD_DOMAIN:localhost} {
	redir https://{$CHAT_DOMAIN}{uri} permanent
}
