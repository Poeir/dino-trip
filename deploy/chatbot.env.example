# Copy to chatbot.env on the VPS (never commit the real file).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM backend: pick ONE ---------------------------------------------------
# A) Vertex AI (billed per token -- set a GCP budget alert + quota first):
#    LLM_PROVIDER=vertex
#    VERTEX_PROJECT=your-gcp-project-id
#    VERTEX_LOCATION=global            # or a region such as asia-southeast1 if you
#                                      # need processing kept in one region (check
#                                      # the model is available there)
#    GOOGLE_APPLICATION_CREDENTIALS=/run/gcp/vertex-sa.json
#    The key file stays out of git (deploy/secrets/ is git-ignored), owned by
#    uid 1000 (the container's appuser) with mode 0400, and is mounted read-only
#    into the chatbot container (see the note in docker-compose.yml). Use a
#    dedicated service account that has only roles/aiplatform.user -- never
#    Editor/Owner.
#    Vertex model names carry a "google/" prefix (e.g. google/gemini-2.5-flash).
# B) KKU gateway (default when LLM_PROVIDER is unset):
KKU_API_KEY=

# Model names. REQUIRED in practice: if unset, the code falls back to defaults
# that the KKU gateway rejects with "401 Invalid model". Copy the values from
# chatbot-service/.env.
MODEL_NAME=
TRIP_PLANNER_MODEL_NAME=

# Optional: tighten/loosen the rate limits (see chatbot-service/src/core/config.py).
# The *_GLOBAL_* caps are a ceiling across all clients combined -- they bound LLM
# spend if many IPs are used. Defaults: chat 120/min & 3000/h, trip 30/10min & 200/h.
# RATE_LIMIT_CHAT_GLOBAL_PER_MINUTE=120
# RATE_LIMIT_CHAT_GLOBAL_PER_HOUR=3000
# RATE_LIMIT_TRIP_GLOBAL_PER_10_MIN=30
# RATE_LIMIT_TRIP_GLOBAL_PER_HOUR=200

# serper.dev key for the admin place form's "generate description with AI"
# button (POST /admin/places/describe). Optional: without it the button still
# works but summarizes Google reviews only, with no web search.
SERPER_API_KEY=

# Browser origins allowed to call this service (comma-separated, no trailing
# slash). Must be your deployed frontend's origin.
CORS_ORIGINS=https://your-frontend.example.com
