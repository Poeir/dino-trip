# Copy to chatbot.env on the VPS (never commit the real file).
KKU_API_KEY=your_kku_gateway_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Model names for the KKU gateway. REQUIRED in practice: if unset, the code
# falls back to defaults (gemini-2.5-*) that the gateway rejects with
# "401 Invalid model". Copy the values from chatbot-service/.env.
MODEL_NAME=
TRIP_PLANNER_MODEL_NAME=

# Browser origins allowed to call this service (comma-separated, no trailing
# slash). Must be your deployed frontend's origin.
CORS_ORIGINS=https://your-frontend.example.com
