# Copy to backend.env on the VPS (never commit the real file). Values come from
# backend/.env. NODE_ENV, PORT, FRONTEND_ORIGIN and CHATBOT_SERVICE_URL are set
# by docker-compose.yml, so they don't belong here.

# Supabase session-mode pooler (port 5432) -- see backend/.env.example.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres

GOOGLE_PLACES_API_KEY=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional sender identity / SMTP provider -- see backend/.env.example.
MAIL_FROM_NAME=Dino
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
