}

get {
  url: {{baseUrl}}/api/admin/event-reports/count
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  ## [Admin] จำนวนรายงานอีเวนท์ที่รอตรวจ

  `GET /api/admin/event-reports/count` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
