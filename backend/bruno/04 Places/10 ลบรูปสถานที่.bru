meta {
  name: Admin ลบรูปสถานที่
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/places/{{placeId}}/photos/{{photoId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  ## [Admin] ลบรูปสถานที่

  `DELETE /api/places/{id}/photos/{photoId}` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
