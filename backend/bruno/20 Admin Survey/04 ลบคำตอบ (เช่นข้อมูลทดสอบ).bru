meta {
  name: Admin ลบคำตอบ (เช่นข้อมูลทดสอบ)
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/admin/survey/{{surveyResponseId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  ## [Admin] ลบคำตอบ (เช่นข้อมูลทดสอบ)

  `DELETE /api/admin/survey/{id}` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 204 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
