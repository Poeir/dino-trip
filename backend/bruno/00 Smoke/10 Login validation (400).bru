meta {
  name: Login validation (400)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "smoke@example.com"
  }
}

assert {
  res.status: eq 400
  res.body.error.message: eq กรุณากรอกอีเมลและรหัสผ่าน
}

docs {
  ชุดตรวจแบบอ่านอย่างเดียว ไม่ต้องล็อกอิน รันได้ด้วย `bru run "00 Smoke" --env local`
}
