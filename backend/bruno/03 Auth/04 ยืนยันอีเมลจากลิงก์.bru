meta {
  name: ยืนยันอีเมลจากลิงก์
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "{{token}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  // Bruno เก็บ cookie ใน cookie jar ให้อัตโนมัติ — สคริปต์นี้เก็บสำเนาไว้ในตัวแปร
  // sessionCookie ด้วย เพื่อให้ `bru run` (CLI) ส่ง cookie ต่อได้แน่นอน
  const raw = res.getHeader("set-cookie");
  const first = Array.isArray(raw) ? raw[0] : raw;
  if (first) bru.setVar("sessionCookie", String(first).split(";")[0]);
}

docs {
  ## ยืนยันอีเมลจากลิงก์

  `POST /api/auth/confirm` · สิทธิ์: ไม่ต้องล็อกอิน

  รับ token จากลิงก์ในอีเมล (`/confirm?token=`) ยืนยันแล้วล็อกอินทันที (ตั้ง cookie) · **Rate limit:** 30 ครั้ง/15 นาที/IP

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
