meta {
  name: ขอลิงก์รีเซ็ตรหัสผ่าน
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com"
  }
}

assert {
  res.status: eq 200
}

docs {
  ## ขอลิงก์รีเซ็ตรหัสผ่าน

  `POST /api/auth/forgot-password` · สิทธิ์: ไม่ต้องล็อกอิน

  ตอบข้อความเดียวกันเสมอไม่ว่าอีเมลจะมีในระบบหรือไม่ (กันการเดาบัญชี) · **Rate limit:** 10 ครั้ง/ชั่วโมง/IP และ 3 ครั้ง/ชั่วโมง/อีเมล

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
