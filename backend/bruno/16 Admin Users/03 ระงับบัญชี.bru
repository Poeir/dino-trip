meta {
  name: Admin ระงับบัญชี
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/users/{{userId}}/suspend
  body: json
  auth: none
}

body:json {
  {
    "reason": "ทำผิดกติกา"
  }
}

assert {
  res.status: eq 200
}

docs {
  ## [Admin] ระงับบัญชี

  `POST /api/admin/users/{id}/suspend` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  ต้องระบุเหตุผล · ระงับตัวเอง/admin คนสุดท้ายไม่ได้ · ยกเลิกทุก session ของผู้ใช้

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
