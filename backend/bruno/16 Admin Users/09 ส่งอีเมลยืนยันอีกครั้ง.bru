}

post {
  url: {{baseUrl}}/api/admin/users/{{userId}}/resend-verification
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  ## [Admin] ส่งอีเมลยืนยันอีกครั้ง

  `POST /api/admin/users/{id}/resend-verification` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
