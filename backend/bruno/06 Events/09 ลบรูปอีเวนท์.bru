meta {
  name: Admin ลบรูปอีเวนท์
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/events/{{eventId}}/photos/{{photoId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  ## [Admin] ลบรูปอีเวนท์

  `DELETE /api/events/{id}/photos/{photoId}` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
