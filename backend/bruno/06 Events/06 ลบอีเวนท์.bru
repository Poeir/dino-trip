meta {
  name: Admin ลบอีเวนท์
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/events/{{eventId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  ## [Admin] ลบอีเวนท์

  `DELETE /api/events/{id}` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 204 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
