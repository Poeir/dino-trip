meta {
  name: Admin ลบความรู้
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/knowledge-base/{{kbId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  ## [Admin] ลบความรู้

  `DELETE /api/knowledge-base/{id}` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 204 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
