meta {
  name: รายการฐานความรู้
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/knowledge-base
  body: none
  auth: none
}

params:query {
  ~page: 1
  ~limit: 1
  ~search: <search>
  ~sort: title
  ~dir: asc
}

assert {
  res.status: eq 200
}

docs {
  ## รายการฐานความรู้

  `GET /api/knowledge-base` · สิทธิ์: ไม่ต้องล็อกอิน

  รวมรายการที่ปิดใช้งาน (`isActive: false`) ด้วย · ไม่ส่ง `page`/`limit` → array · cache 25 วินาที

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
