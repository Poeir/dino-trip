meta {
  name: Admin ลบ QR
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/qrs/{{qrId}}
  body: none
  auth: none
}

assert {
  res.status: eq 204
}

docs {
  ## [Admin] ลบ QR

  `DELETE /api/qrs/{id}` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 204 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
