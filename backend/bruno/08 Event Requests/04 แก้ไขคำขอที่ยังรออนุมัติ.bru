meta {
  name: แก้ไขคำขอที่ยังรออนุมัติ
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/event-requests/{{eventRequestId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "งานไหมขอนแก่น",
    "category": "เทศกาล",
    "dateRange": "4-8 พ.ย. 2569",
    "venueName": "ศาลากลางจังหวัดขอนแก่น",
    "admission": "เข้าฟรี",
    "organizer": "<organizer>",
    "suitableFor": [
      "<suitableFor>"
    ],
    "desc": "<desc>",
    "status": "upcoming",
    "eventStartDate": "2026-11-04",
    "eventEndDate": "2026-11-08",
    "placeId": "{{placeId}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  ## แก้ไขคำขอที่ยังรออนุมัติ

  `PUT /api/event-requests/{id}` · สิทธิ์: ต้องล็อกอิน (รัน "Auth / Login (user)" ก่อน)

  คาดหวัง: HTTP 200 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
