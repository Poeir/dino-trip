meta {
  name: Admin ลบแผนทริปถาวร
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/admin/trips/{{tripId}}/delete
  body: json
  auth: none
}

body:json {
  {
    "reason": "<reason>"
  }
}

assert {
  res.status: eq 204
}

docs {
  ## [Admin] ลบแผนทริปถาวร

  `POST /api/admin/trips/{id}/delete` · สิทธิ์: ต้องล็อกอินเป็น admin (รัน "Auth / Login (admin)" ก่อน)

  คาดหวัง: HTTP 204 เมื่อสำเร็จ · error ตอบเป็น `{ "error": { "message": "..." } }`
}
