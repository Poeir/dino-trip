SUPABASE_URL=https://your-project.supabase.co
# Service role key: full DB access, bypasses RLS. Keep this out of the frontend
# and out of version control -- used by backend scripts and by src/server.js.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key: used only by src/lib/supabaseAuthClient.js for tourist login/
# signup/refresh (routes/auth.routes.js). It's the "public" key by Supabase's
# own design, but it stays server-side here -- the browser never receives a
# Supabase credential at all, only the httpOnly session cookies /api/auth
# sets. Find it under Project Settings > API (same project as SUPABASE_URL).
SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/fetch-places.js (Places API (New) must be enabled, with billing).
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Port for the backend API (src/server.js). Frontend's VITE_API_URL should
# point at http://localhost:PORT.
PORT=4000

# Origin the frontend is served from -- must match exactly (scheme+host+port)
# for the browser to accept the session cookies /api/auth sets (see cors()
# in src/app.js). Set to the deployed frontend's origin in production.
FRONTEND_ORIGIN=http://localhost:5173
