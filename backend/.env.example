SUPABASE_URL=https://your-project.supabase.co
# Service role key: full DB access, bypasses RLS. Keep this out of the frontend
# and out of version control -- used by backend scripts and by src/server.js.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by scripts/fetch-places.js (Places API (New) must be enabled, with billing).
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Port for the backend API (src/server.js). Frontend's VITE_API_URL should
# point at http://localhost:PORT.
PORT=4000
