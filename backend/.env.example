# Direct Postgres connection string (src/lib/db.js, via Knex) -- every route
# and lib in this backend reads/writes through this single connection, no
# Supabase client library involved. If the plain direct-connection host
# (db.<project-ref>.supabase.co:5432) fails to resolve (it's IPv6-only on
# some projects), use the IPv4-compatible session pooler instead: find both
# under Supabase Dashboard > Project Settings > Database > Connection string.
# Use session mode (port 5432), not transaction mode (6543) -- this is a
# long-running server, not a serverless function.
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Used only by scripts/fetch-places.js (Places API (New) must be enabled, with billing).
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Port for the backend API (src/server.js). Frontend's VITE_API_URL should
# point at http://localhost:PORT.
PORT=4000

# Origin the frontend is served from -- must match exactly (scheme+host+port)
# for the browser to accept the session cookies /api/auth sets (see cors()
# in src/app.js). Set to the deployed frontend's origin in production.
FRONTEND_ORIGIN=http://localhost:5173

# Gmail SMTP account used to send signup confirmation emails (see
# src/lib/mailer.js, used from routes/auth.routes.js). GMAIL_APP_PASSWORD
# must be a Gmail App Password, not the account's normal login password --
# requires 2-Step Verification enabled first: myaccount.google.com/apppasswords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
